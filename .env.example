# Copy to .env and customize values as needed
# Docker Compose will source these variables automatically

# PostgreSQL credentials (for docker-compose)
POSTGRES_USER=shrtr
POSTGRES_PASSWORD=shrtr
POSTGRES_DB=shrtr

# Application URLs
DATABASE_URL=postgresql+asyncpg://shrtr:shrtr@localhost:5432/shrtr
REDIS_URL=redis://localhost:6379/0
BASE_URL=http://localhost:8000

# Optional: deterministic demo key so `make seed` is repeatable
# SEED_API_KEY=change-me-32-bytes-of-randomness
